# Search API — choose one provider
SEARCH_PROVIDER=mock   # mock | bing | serpapi | google

# Bing Web Search API
BING_API_KEY=

# SerpAPI
SERPAPI_KEY=

# Google Custom Search
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Rate limiting (seconds between requests)
REQUEST_DELAY=1.5
SEARCH_DELAY=2.0

# Cache TTL in hours
CACHE_TTL_HOURS=24

# Optional: enable SMTP MX probing (default off)
ENABLE_SMTP_PROBE=false

# Log level
LOG_LEVEL=INFO
